{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-studio-konten",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "development"
  },
  // Secrets (jangan diisi di file ini):
  // XAI_API_KEY, MASTER_EMAIL, MASTER_PASSWORD, TURNSTILE_SECRET, TURNSTILE_SITE_KEY,
  // TURNSTILE_BYPASS, XAI_MOCK, MIDTRANS_SERVER_KEY, MIDTRANS_CLIENT_KEY, MIDTRANS_ENABLED,
  // TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, ALERT_EMAIL
  // Lokal: taruh di .dev.vars. Production: `wrangler secret put NAMA`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-studio-konten",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "ai-studio-konten"
    }
  ]
}
